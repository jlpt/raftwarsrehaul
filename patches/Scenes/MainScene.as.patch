+      // MOD: odds of each tier (yellow, purple, white, rainbow) in the extra missions
+      public function extraTierWeights() : Array
+      {
+         if(currentEpisode == 13)
+         {
+            return [0.55,0.45,0,0];
+         }
+         if(currentEpisode == 14)
+         {
+            return [0.15,0.6,0.25,0];
+         }
+         if(currentEpisode == 15)
+         {
+            return [0,0.4,0.5,0.1];
+         }
+         return [0,0.1,0.5,0.4];
