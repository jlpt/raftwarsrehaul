+                     {
+                        best = [gx,gy];
+                     }
+                  }
+                  else if(!lg.getCellData(gx,gy,"Data") && (best == null || Math.abs(gx - player.gridx) + Math.abs(gy - player.gridy) < Math.abs(best[0] - player.gridx) + Math.abs(best[1] - player.gridy)))
+                  {
+                     best = [gx,gy];
+                  }
+               }
+               gx++;
+            }
+            gy++;
+         }
+         if(!best)
+         {
+            return "NOWHERE TO GO";
+         }
+         oldGridX = player.gridx;
+         oldGridY = player.gridy;
+         player.gridx = best[0];
+         player.gridy = best[1];
+         player.destBaseX = 400;
+         player.destBaseY = 300;
+         if(lg.getCell(best[0] - 1,best[1]) > 0)
+         {
+            player.destBaseX = 40;
+         }
+         else if(lg.getCell(best[0] + 1,best[1]) > 0)
+         {
+            player.destBaseX = 760;
+         }
+         else if(lg.getCell(best[0],best[1] - 1) > 0)
+         {
+            player.destBaseY = 40;
+         }
+         else if(lg.getCell(best[0],best[1] + 1) > 0)
+         {
+            player.destBaseY = 560;
+         }
+         fading = 1;
+         return "OFF TO ROOM " + best[0] + "," + best[1];
