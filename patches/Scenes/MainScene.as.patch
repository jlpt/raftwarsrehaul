+      public function doExtraEnemyDifficulty() : void
+      {
+         var go:GameObject = null;
+         var roll:Number = NaN;
+         var i:int = 0;
+         var tier:int = 0;
+         var weights:Array = extraTierWeights();
+         for each(go in objects)
+         {
+            if(go is EnemyBase && !(go is BossBase) && !(go is ComsTowerBase) && !(go is WalkerTurretBase))
+            {
+               roll = Math.random();
+               i = 0;
+               while(i < weights.length - 1 && roll >= weights[i])
+               {
+                  roll -= weights[i];
+                  i++;
+               }
+               tier = 3 + i;
+               if(go is BeserkerBase && tier > 2)
+               {
+                  tier = 2;
+               }
+               if(go is WalkerBase && tier > 3)
+               {
+                  tier = 3;
+               }
+               EnemyBase(go).setupDifficulty(tier);
+            }
+         }
       }
       
