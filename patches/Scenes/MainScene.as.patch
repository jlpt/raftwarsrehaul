+      // MOD: after the tiers are set: some enemies become variants (wardens are only placed), then elites;
+      // wardens are always at least shielded
+      public function doEliteRolls() : void
+      {
+         var go:GameObject = null;
+         var e:EnemyBase = null;
+         var v:int = 0;
+         var tries:int = 0;
+         var pick:int = 0;
+         for each(go in objects)
+         {
+            e = go as EnemyBase;
+            if(!e || e.elite > 0 || e._killed)
+            {
+               continue;
+            }
+            if(e.variant == 0 && Math.random() < variantChance())
+            {
+               v = 1;
+               while(v < EnemyBase.VARIANT_COUNT)
+               {
+                  if(v != EnemyBase.V_WARDEN && e is EnemyBase.variantHost(v))
+                  {
+                     e.makeVariant(v);
+                     break;
+                  }
+                  v++;
+               }
+            }
+            if(e.variant == EnemyBase.V_WARDEN)
+            {
+               e.makeElite(EnemyBase.ELITE_SHIELDED);
+            }
+            else if(e.canBeElite() && Math.random() < eliteChance())
+            {
+               tries = 0;
+               while(tries < 10)
+               {
+                  pick = Random.randInt(1,EnemyBase.ELITE_COUNT - 1);
+                  if(e.canHaveElite(pick))
+                  {
+                     e.makeElite(pick);
+                     break;
+                  }
+                  tries++;
+               }
+            }
+         }
+      }
+
+      public function doExtraEnemyDifficulty() : void
+      {
+         var go:GameObject = null;
+         var roll:Number = NaN;
+         var i:int = 0;
+         var tier:int = 0;
+         var weights:Array = extraTierWeights();
+         for each(go in objects)
+         {
+            if(go is EnemyBase && !(go is BossBase) && !(go is ComsTowerBase) && !(go is WalkerTurretBase))
+            {
+               roll = Math.random();
+               i = 0;
+               while(i < weights.length - 1 && roll >= weights[i])
+               {
+                  roll -= weights[i];
+                  i++;
+               }
+               tier = 3 + i;
+               if(go is BeserkerBase && tier > 2)
+               {
+                  tier = 2;
+               }
+               if(go is WalkerBase && tier > 3)
+               {
+                  tier = 3;
+               }
+               EnemyBase(go).setupDifficulty(tier);
+            }
+         }
       }
       
