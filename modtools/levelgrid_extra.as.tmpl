      public static function levelInit(param1:int, param2:int, param3:int) : Array
      {
         var room:Array = null;
         var result:Array = null;
         var marker:int = 0;
         var objs:Array = null;
         var i:int = 0;
         if(param1 < FIRST_EXTRA_EPISODE)
         {
            return mainGameLevels.init(param1,param2,param3);
         }
         for each(room in EXTRA_MISSIONS[param1])
         {
            if(room[0] == param2 && room[1] == param3)
