index 0000000..2ac31ac
--- /dev/null
+++ b/desktop/src/robokill.rs
@@ -0,0 +1,83 @@
+//! Robokill Mod standalone build: the game SWF is baked into the executable.
+
+use anyhow::{Context, Error, anyhow};
+use std::sync::{Mutex, OnceLock};
+use url::Url;
+
+pub const TITLE: &str = "Robokill Mod";
+
+static SWF: &[u8] = include_bytes!("../../../../robokill_mod.swf");
+static EMBEDDED_URL: OnceLock<Url> = OnceLock::new();
+
+/// Writes the built-in SWF to the local data directory (only if it changed) and returns its URL.
+///
+/// Loading it from disk keeps behaviour identical to opening the file in a regular Ruffle.
+/// Saves don't depend on this location: the game stores them under `localhost/robokill`.
+pub fn extract_swf() -> Result<Url, Error> {
+    let dir = dirs::data_local_dir()
+        .context("Couldn't find a valid data_local dir")?
+        .join("RobokillMod");
+    std::fs::create_dir_all(&dir).context("Failed to create RobokillMod data directory")?;
+
+    let path = dir.join("robokill_mod.swf");
+    if std::fs::read(&path).ok().as_deref() != Some(SWF) {
+        let tmp_path = dir.join("robokill_mod.swf.tmp");
+        std::fs::write(&tmp_path, SWF).context("Failed to write robokill_mod.swf")?;
+        std::fs::rename(&tmp_path, &path).context("Failed to replace robokill_mod.swf")?;
+    }
+
+    let url = Url::from_file_path(&path).map_err(|_| anyhow!("Invalid SWF path {path:?}"))?;
+    let _ = EMBEDDED_URL.set(url.clone());
+    Ok(url)
+}
+
+/// Window title for a movie: just the game name for the built-in SWF.
+pub fn window_title(movie_url: &Url, readable_name: &str) -> String {
+    if EMBEDDED_URL.get() == Some(movie_url) {
+        TITLE.to_string()
+    } else {
+        format!("{TITLE} - {readable_name}")
+    }
+}
+
+/// Shows a startup error, since the Windows build has no console to print it to.
+pub fn show_error(error: &Error) {
+    rfd::MessageDialog::new()
+        .set_level(rfd::MessageLevel::Error)
+        .set_title(TITLE)
+        .set_description(format!("{error:#}"))
+        .show();
+}
+
+/// Identifies this build in the log.
+pub fn log_startup() {
+    tracing::info!(
+        "Robokill Mod exe built {}, game SWF {} bytes",
+        env!("VERGEN_BUILD_TIMESTAMP"),
+        SWF.len()
+    );
+}
+
+/// Logs window size, Ruffle viewport and stage scale mode whenever they change, so a player's log
+/// (`%LOCALAPPDATA%\ruffle\log`) shows how the game is being sized on their machine.
+pub fn log_display_state(player: &mut ruffle_core::Player, window: &winit::window::Window) {
+    static LAST: Mutex<String> = Mutex::new(String::new());
+    let size = window.inner_size();
+    let viewport = player.viewport_dimensions();
+    let state = format!(
+        "window {}x{} (scale factor {:.2}, fullscreen {}), viewport {}x{}, stage scale mode {:?}",
+        size.width,
+        size.height,
+        window.scale_factor(),
+        window.fullscreen().is_some(),
+        viewport.width,
+        viewport.height,
+        player.scale_mode()
+    );
+    if let Ok(mut last) = LAST.lock()
+        && *last != state
+    {
+        tracing::info!("Robokill display: {state}");
+        *last = state;
+    }
+}
